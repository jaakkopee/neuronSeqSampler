            // Minimal RhythmInterpreter: setUseBeatTracker method not supported
            
            if (newState) {
                std::cout << "🎯 BeatTracker enabled via GUI (minimal mode)" << std::endl;
                // Minimal RhythmInterpreter: initializeBeatTracker and getBPM methods not supported
                beatRootToggle->getRenderer()->setBackgroundColor(tgui::Color(80, 80, 140));
