    // BeatTracker controls have been removed from the GUI to simplify the interface
    // The BeatTracker system is disabled by default in RhythmInterpreter
    
    /* BeatTracker controls disabled in minimal RhythmInterpreter */
    float beatRootControlsX = scaleSliderX - 200; // Position BeatTracker controls much further left to avoid scale/BPM controls
    
    // BeatTracker toggle button - aligned with other controls
    beatRootToggle = tgui::Button::create("BeatTracker");
    beatRootToggle->setPosition(beatRootControlsX - 10, 70);
    beatRootToggle->setSize(80, 30);
    beatRootToggle->setTextSize(11);
    beatRootToggle->getRenderer()->setBackgroundColor(tgui::Color(40, 40, 80)); // Different color for BeatTracker
    beatRootToggle->getRenderer()->setTextColor(tgui::Color(180, 180, 180));
    beatRootToggle->getRenderer()->setBorderColor(tgui::Color(80, 80, 120));
    beatRootToggle->getRenderer()->setBorders(1);
    
    // Set initial state based on RhythmInterpreter
    if (rhythmInterpreter && rhythmInterpreter->getUseBeatTracker()) {
        beatRootToggle->getRenderer()->setBackgroundColor(tgui::Color(80, 80, 140));
        beatRootToggle->getRenderer()->setTextColor(tgui::Color(255, 255, 255));
    }
    
    beatRootToggle->onPress([this]() {
